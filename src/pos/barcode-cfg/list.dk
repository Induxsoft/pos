#include "dkli.dkh"
#!
module ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"

    do @context.begin(@crud_context)
    // do rise_error(0,to.json(@crud_context))
    buttons::
    {
        #$
        button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" type="submit" form="form-cfg"){$"Guardar"}
        #!
    }

    point buttons to buttons
    new nav_config
    {
        @"title": "Códigos de barras segmentados o compuestos"
        @"buttons*": buttons
        @"urlexit": "/"
        @"jscurrentcontext": "getCurrentContext"
    }

    #$ div(class="container v12-list-view" id="view")
    {
        section(class="" id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$
        }
        section(id="work_area")
        {
            #!
            if trim(@("$error/message")) !=""
            {
                #$
                div(class="alert alert-danger"){"#<('$error/message')>"}
            }
            form(action="." method="POST" id="form-cfg" onsubmit="return validateFields()")
            {
                h5{"Regla 1"}
                div(class="row ms-2")
                {
                    div(class="col-md-4")
                    {
                        label(class="" "for"=""){"Mascara:"}
                        input(class="induxsoft-form-control form-control-sm" name="mascara1" value="#<@('$./mascara1')>")
                    }
                    div(class="col-md-2")
                    {
                        label(class="" "for"=""){"Factor:"}
                        input(class="induxsoft-form-control form-control-sm" type="number" name="factor1" value="#<@('#./factor1')>")
                    }
                }

                h5{"Regla 2"}
                div(class="row ms-2")
                {
                    div(class="col-md-4")
                    {
                        label(class="" "for"=""){"Mascara:"}
                        input(class="induxsoft-form-control form-control-sm" name="mascara2" value="#<@('$./mascara2')>")
                    }
                    div(class="col-md-2")
                    {
                        label(class="" "for"=""){"Factor:"}
                        input(class="induxsoft-form-control form-control-sm" type="number" name="factor2" value="#<@('#./factor2')>")
                    }
                }

                h5{"Regla 3"}
                div(class="row ms-2")
                {
                    div(class="col-md-4")
                    {
                        label(class="" "for"=""){"Mascara:"}
                        input(class="induxsoft-form-control form-control-sm" name="mascara3" value="#<@('$./mascara3')>")
                    }
                    div(class="col-md-2")
                    {
                        label(class="" "for"=""){"Factor:"}
                        input(class="induxsoft-form-control form-control-sm" type="number" name="factor3" value="#<@('#./factor3')>")
                    }
                }

                h5{"Regla 4"}
                div(class="row ms-2")
                {
                    div(class="col-md-4")
                    {
                        label(class="" "for"=""){"Mascara:"}
                        input(class="induxsoft-form-control form-control-sm" name="mascara4" value="#<@('$./mascara4')>")
                    }
                    div(class="col-md-2")
                    {
                        label(class="" "for"=""){"Factor:"}
                        input(class="induxsoft-form-control form-control-sm" type="number" name="factor4" value="#<@('#./factor4')>")
                    }
                }

                h5{"Regla 5"}
                div(class="row ms-2")
                {
                    div(class="col-md-4")
                    {
                        label(class="" "for"=""){"Mascara:"}
                        input(class="induxsoft-form-control form-control-sm" name="mascara5" value="#<@('$./mascara5')>" )
                    }
                    div(class="col-md-2")
                    {
                        label(class="" "for"=""){"Factor:"}
                        input(class="induxsoft-form-control form-control-sm" type="number" name="factor5" value="#<@('#./factor5')>")
                    }
                }
            }
        }
        script(src="/$/pos/js/barcode-cfg.js"){""}
    }
}