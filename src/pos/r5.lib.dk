#include "dkli.dkh"
#!
module ""
{
    Record_enum::&db,table,field,value
    {
        new p{}
        p<field>:value
        return dbr.rec(db,"select id,const from "+table+" where "+field+"=@"+field+";",p)
    }
    Record_enum_explicit::&db,&registro, columna, tabla, byfield,getfield
    {
        if field.exist(registro,columna)
        {
            ref k=Record_enum(db,tabla,byfield,field.str(registro,columna))
            if isnull(k){return}
            
            registro<columna>:@@(k,getfield)

            return k
        }

        return @null
    }
    CopyRecord::&record1,&record2
    {
        ref lrecord=list.create_from_fields(record2)
        for i = 0; i < @count(lrecord)
        {
            f=list.str(lrecord,i)
            record1<f>:@@(record2,f)
        }
    }
    DeleteFields::&record,fields
    {
        ref lf=split(fields,",")
        for i = 0; i < @count(lf)
        {
            do field.remove(record,list.str(lf,i))
        }
    }
    Importar.row::&db,&row,table,campo,value,conditional,id
    {
        _text=ifstr(trim(@@(row,"$"+campo))!="",@@(row,"$"+campo),str(id))
        
        if id < 1
        {
            ref new_row:default_r5_entity()
            do CopyRecord(row,new_row)
            do dbr.insert(db,table,row)
            do print(" - "+table+" "+_text+" insertado")
        }
        else 
        {
            conditional=ifstr(trim(conditional)!="",conditional,"#<campo>=@#<campo>")

            do dbr.update(db,table,row,ftext(conditional),row)
            do print(" - "+table+" "+_text+" actualizado")
        }
    }
 

    @__delfields="sys_pk,sys_guid,sys_deleted"
    //Función global
    Importar.data::&db,&data,table,&funct_validate
    {
        for i = 0; i < @count(data)
        {
            ref _dt=@item(data,i)
            //prevenir campos de sistema
            do DeleteFieldsByTable(_dt,table)
            
            campo="codigo"
            ref res=record.create()
            //ejecutar función si no es nulo
            if not(isnull(funct_validate))
            {
                that funct_validate(db,data,_dt,table,i)->*res
                if @@(res,"$_field")!=""{campo=@@(res,"$_field")}
            }
            //verificar el id, si no existe buscarlo mediante el campo indicado
            if not(field.exist(res,"id"))
            {
                res<"id">:obtener_clave(db,table,campo,@@(_dt,"$"+campo))
            }
            //si continue es true no se realiza la importación
            if not(parse.bool(@@(res,"continue")))
            {
                //insertar o actualizar fila
                do Importar.row(db,_dt,table,campo,@@(_dt,"$"+campo),@@(res,"$conditional"),@@(res,"#id"))
            }

            exception
            {
                do print("Error a importar "+table+": "+last_error())
            }
        }
    }
    //esto para prevenir que vengan otros campos que no son parte de r5
    DeleteFieldsByTable::&row,table
    {
        //eliminar campos de systema sys_ (por si lo hubiera)
        do DeleteFields(row,@__delfields)
        switch table
        {
            case "divisa"
            {
                do DeleteFields(row,"decimales")
                break
            }
            case "agente"
            {
                do DeleteFields(row,"uf_capitan")
                break
            }
            case "almacen"
            {
                do DeleteFields(row,"clase")
                break
            }
            case "cliente"
            {
                do DeleteFields(row,"cfdi_emisor")
                break
            }
            case "cconsumo"
            {
                do DeleteFields(row,"cfdi_emisor")
                break
            }
            case "linea"
            {
                do DeleteFields(row,"uf_indicaciones,img_file")
                break
            }
        }
    }
    //Importar producto
    @__alias_columnas="marca:imarca,                    
                    linea:ilinea,                    
                    divisa:idivisa,                    
                    departamento:idepartamento,                    
                    clase:iclase,                    
                    tipo:itipo                    
                    "
    Importar.producto::&db,&productos
    {
        if isnull(productos) || @count(productos)< 1{return}
        //Alias conocidos de columnas de la tabla producto
        ref ldetalle=list.create()
        //Insertar productos
        for i = 0; i < @count(productos)
        {
            ref producto=@item(productos,i)
            
            do DeleteFields(producto,@__delfields)
            do DeleteFields(producto,"detalle,gruposproductos,variables,uf_solicitarcantidad")
            //Campos requeridos que si no están establecidos se les asigna un valor predeterminado
            //Esta sección de código es ilustrativa y debería usarse únicamente como guía
            do set_default(producto, "linea","0001")
            do set_default(producto, "impuestos","IVA 16% (México)")
            //do set_default(producto, "metodovaluacion","UEPS")
            ///////////////////////////////////////////////////////////////////////////////////////

            //Reemplazo de campos que se importan indicando código por la clave primaria de la tabla referenciada
            do clave_codigo(db,producto, "divisa")
            do clave_codigo(db,producto, "linea")
            do clave_codigo(db,producto, "marca")
            do clave_codigo(db,producto, "departamento")  
            
            do clave_enum_explicit(db,producto, "clase","cclaseproducto","const")  
            do clave_enum_explicit(db,producto, "tipo","ctipoproducto","const")  
            do clave_enum_explicit(db,producto, "metodovaluacion","cmetodosvaluacion","const")  

            do Record_enum_explicit(db,producto, "formacomision","cformacomisionproducto","const","#id")  
            do Record_enum_explicit(db,producto, "tipocomision","ctiposcomisionesproducto","const","#id")  
            //verificar si el campo clase trae datos
            do clave_codigo_explicit(db,producto, "proveedor1","proveedor","codigo")
            do clave_codigo_explicit(db,producto, "proveedor2","proveedor","codigo")
            do clave_codigo_explicit(db,producto, "proveedor3","proveedor","codigo")
            do clave_codigo_explicit(db,producto, "impuestos","cfgimpuesto","nombre")
            
            //Reemplazar alias conocidos
            ref producto:record.copyexin(producto,@null,"*","",@__alias_columnas,":")
            
            ///////////////////////////////////////////////////////////////////////////////////////

            //Inserta o actualiza con base en el código
            do print_actualizar_producto(db, producto)
        }
    }

    Importar.precioventa::&db,&data
    {
        for i = 0; i < @count(data)
        {
            ref _dt=@item(data,i)
            id_producto=obtener_clave(db,"producto","codigo",@@(_dt,"$producto"))
            id_cliente=obtener_clave(db,"cliente","codigo",@@(_dt,"$cliente"))

            id_producto,id_cliente >> _dt

            pk_exist=dbr.num(db,"select sys_pk from precioventa where producto=@producto and fk_cliente_listaprecios=@fk_cliente_listaprecios",_dt)
            
            if pk_exist > 0
            {
                pk_exist >> p
                ref precio_venta=record.copy(_dt,"precio,limite")
                do dbr.update(db,"precioventa",precio_venta,"sys_pk=@pk",p)
                do print(" ** Precioventa, cliente: "+@@(_dt,"$producto")+" producto: "+@@(_dt,"$cliente")+" actualizado")
            }
            else 
            {
                ref precio_venta:default_r5_entity()
                using precio_venta
                {
                    @"precio":@@(_dt,"#precio")
                    @"limite":@@(_dt,"#limite")
                    @"producto":id_producto
                    @"fk_cliente_listaprecios":id_cliente
                }
                do dbr.insert(db,"precioventa",precioventa)
                do print(" ** Precioventa, cliente: "+@@(_dt,"$producto")+" producto: "+@@(_dt,"$cliente")+" insertado")
            }
        }
    }
    //funciones de validaciones
    ValidateCfgImpueto::&db,&data,&row,table,index
    {
        new res{@"_field":"nombre"}
        return res
    }
    ValidateCliente::&db,&data,&row,table,index
    {
        id_divisa=obtener_clave(db,"divisa","codigo",@@(row,"$divisa"))
        id_tipo=obtener_clave(db,"tipocliente","codigo",@@(row,"$tipo"))
        
        if id_divisa < 1{do rise_error(99,"No se encontró la divisa: "+@@(row,"$divisa"))}
        if id_tipo < 1{do rise_error(99,"No se encontró el tipo de cliente: "+@@(row,"$tipo"))}

        using row
        {
            @"idivisa":id_divisa
            @"tipo":id_tipo
        }

        do field.remove(row,"divisa")
    }
    ValidateCConsumo::&db,&data,&row,table,index
    {
        id_almacen=obtener_clave(db,"almacen","codigo",@@(row,"$almacen"))
        if id_almacen< 1{do rise_error(99,"No se econtro el álmacen:"+@@(row,"$almacen"))}
        using row
        {
            @"ialmacen":id_almacen
        }

        do field.remove(row,"almacen")
    }
    ValidateCProduccion::&db,&data,&row,table,index
    {
        id_almacenmp=obtener_clave(db,"almacen","codigo",@@(row,"$almacenmp"))
        id_almacenpt=obtener_clave(db,"almacen","codigo",@@(row,"$almacenpt"))
        if id_almacenmp< 1{do rise_error(99,"No se econtro el álmacen:"+@@(row,"$almacenmp"))}
        if id_almacenpt< 1{do rise_error(99,"No se econtro el álmacen:"+@@(row,"$almacenpt"))}

        using row
        {
            @"almacenmp":id_almacenmp
            @"almacenpt":id_almacenpt
        }
    }
    ValidateEnsamble::&db,&data,&row,table,index
    {
        id_producto_elm=obtener_clave(db,"producto","codigo",@@(row,"$elemento"))
        id_producto_remp=obtener_clave(db,"producto","codigo",@@(row,"$reemplazo"))
        id_producto=obtener_clave(db,"producto","codigo",@@(row,"$producto"))
        
        if id_producto_elm< 1{do rise_error(99,"No se econtro el producto:"+@@(row,"$elemento"))}
        if id_producto< 1{do rise_error(99,"No se econtro el producto:"+@@(row,"$producto"))}

        if id_producto_remp > 0{row<"reemplazo">:id_producto_remp}

        using row
        {
            @"elemento":id_producto_elm
            @"fk_producto_elementos":id_producto
        }
        id =dbr.num(db,"select sys_pk from iensamble where elemento=@elemento and fk_producto_elementos=@fk_producto_elementos",row)
        new res
        {
            id:=id
        }

        if id > 0
        {
            res<"conditional">:"elemento=@elemento and fk_producto_elementos=@fk_producto_elementos"
        }
        do field.remove(row,"producto")
        return res
    }
}