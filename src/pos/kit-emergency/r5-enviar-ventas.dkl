#include "dkli.dkh"
#!
program ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "webcl.dkh"
    #include "r5.lib.dk"
    #include "dbr.ftt.dkl"
    #include "r5.dkh" //Funciones de interoperabilidad con versiones R5 de Induxsoft

    @PathLog="" //ruta donde se guardaran los log, si es vació no creará log
    @r5.program.gen.ventas="ftt.r5.ex.ventas.dkl" //herramienta que realiza las exportaciones de ventas
    @r5.path.outfile="transactions"//ruta donde se almacenaran los archivos con las ventas exportadas
    @r5.file.extension=".fttjson" //extension del archivo
    @r5.documentos="6" //tipos de documentos de la ventas que seran exportados/importados, separados por coma,vacio seria todos los documentos
    @r5.dnms_ord=@true
    @r5.delete.file.onsuccess=@false // si es true el archivo de transación es elimida despues de tener exito de importacion
    @r5.StatusAdministrativo="3" //estados en la cual se exportaran las ventas, 3- solo procesados

    //1.- Obetener los args
    ref args=commandline("=")
    if trim(@@(args,"$qn"))==""{do rise_error(99,"No ha indicado el parámetro 'qn' (Nombre cualificado a una conexión) ")}
    if trim(@@(args,"$uri"))==""{do rise_error(99,"No ha indicado el parámetro 'url' (URL del servicio) ")}
    if trim(@@(args,"$uid"))==""{do rise_error(99,"No ha indicado el parámetro 'uid' (usuario)")}
    if trim(@@(args,"$pwd"))==""{do rise_error(99,"No ha indicado el parámetro 'pwd' (contraseña del usuario)")}

    if not(field.exist(args,"dmns_ord")){args<"dmns_ord">:@r5.dnms_ord}
    //variables globales
    @qname=trim(@@(args,"$qn"))
    @uid=trim(@@(args,"$uid"))
    @pwd=trim(@@(args,"$pwd"))
    
    @r5.url.service=trim(@@(args,"$uri"))
    ref db=dbr.open(@qname)

    //crear tabla de control de transaccciones
    do CreateTableIfNotExist(db)

    //1.- realizar petición al servicio con transaciones pendientes
    do SendDataServicePending(db,args)

    //2.- Generar nuevas atransaciones
    dmns_ord=parse.bool(@@(args,"dmns_ord"))
    if dmns_ord{dmns_ord=TableExist(db,"orden")}

    new transacion
    {
        @"fecha":trim(@@(args,"$i"))
        @"ubicacion":trim(@@(args,"$ub"))
        @"dmns_ord":dmns_ord
        @"documentos":@r5.documentos
        @"status":@r5.StatusAdministrativo
    }

    do GenTransAndRegister(db,@qname,transacion)

    //3.- enviar transaciones nuevas
    do SendDataServicePending(db,args)
    
    if dbr.is_open(db){do dbr.close(db)}

    exception
    {
        do print("**** Error: "+ last_error())
        if isset("db")
        {
            //si la bd esta abierta, realizar los siguiente.
            if dbr.is_open(db)
            {
                //si la bd esta en transacción, deshacer todo
                if  dbr.in_transaction(db){do dbr.rollback(db)}
                //cerrar base de datos
                do dbr.close(db)
            }
        }
    }

    do SaveLog(@PathLog)
}