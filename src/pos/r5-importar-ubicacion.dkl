#include "dkli.dkh"
#!
program ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "webcl.dkh"
    #include "r5.lib.dk"
    #include "r5.dkh" //Funciones de interoperabilidad con versiones R5 de Induxsoft
    
    @PathLog="C:/Users/Dev/Documents/devkrons/devkronNet/tools/log_importart/"
    @hide_productos=@true
    //1.- Obetener los args
    ref args=commandline("=")
    if trim(@@(args,"$qn"))==""{do rise_error(99,"No ha indicado el parámetro 'qn' (Nombre cualificado a una conexión) ")}
    if trim(@@(args,"$uri"))==""{do rise_error(99,"No ha indicado el parámetro 'url' (URL del servicio) ")}
    if trim(@@(args,"$uid"))==""{do rise_error(99,"No ha indicado el parámetro 'uid' (usuario)")}
    if trim(@@(args,"$pwd"))==""{do rise_error(99,"No ha indicado el parámetro 'pwd' (contraseña del usuario)")}

    if trim(@@(args,"$log"))!=""{@PathLog=trim(@@(args,"$log"))}
    //variables globales
    @qname=trim(@@(args,"$qn"))
    @uri=trim(@@(args,"$uri"))
    @uid=trim(@@(args,"$uid"))
    @pwd=trim(@@(args,"$pwd"))

    //1.- conectar a la base de datos
    
    ref db=dbr.open(@qname)

    //2.- realizar petición al servicio y parsear la respuesta
    //prepara petición
    new h{@"content-type":"application/json"}
    new data
    {
        @"uid":@uid
        @"pwd":@pwd
        @"ub":trim(@@(args,"$ub"))
    }
    
    do PrintLog("***** ===== Realizando solicitud de datos ===== *****")

    res=http.request(@uri,"POST",h,to.json(data))
    ref result=from.json(res)
    if not(@@(result,"#success")){do rise_error(99,@@(result,"$message"))}

    do PrintLog("*****  ===== Datos obtenidos correctamente ==== ***** ")

    ref data=@@(result,"&data")

    ref @function_validate=@null
    do @context.begin(data)
    //3.-  realizar el proceso de importación
    ref divisas=@("&divisas")
    ref cajeros=@("&cajeros")
    ref agentes=@("&agentes")
    ref marcas=@("&marcas")
    ref departamentos=@("&departamentos")
    ref repartidores=@("&repartidores")
    ref almacenes=@("&almacenes")
    ref cfgimpuestos=@("&cfgimpuestos")
    ref cconsumos=@("&cconsumo")
    ref cproduccion=@("&cproduccion")
    ref cajas=@("&cajas")
    ref tipoclientes=@("&tipoclientes")
    ref clientes=@("&clientes")
    ref ubicacion=@("&ubicacion")
    
    ref lineas=@("&lineas")
    ref productos=@("&productos")
    ref productos_elementos=@("&productos_elementos")
    ref productos_remplazos=@("&productos_remplazos")
    ref precios_x_cliente=@("&precios_x_cliente")
    ref ensambles=@("&ensambles")
    ref grupoproductos=@("&grupoproductos")
    ref variables=@("&variables")
    ref cproducionproductos=@("&cproducionproductos")

    if isnull(ubicacion)
    {
        do PrintLog("***** ===== Todos los datos =====*****")
    }
    else 
    {
        do PrintLog("***** ===== Ubicación: "+@@(ubicacion,"$descripcion")+" =====*****")
    }

    do PrintLog("\n")
    do PrintLog("***** ===== Inicio del proceso de importación ===== *****")

    do PrintLog("\n")
    do PrintLog("====Importar divisas: "+str(@count(divisas))+" ====")
    do Importar.data(db,divisas,"divisa",@null)

    do PrintLog("\n")
    do PrintLog("====Importar cajeros: "+str(@count(cajeros))+" ====")
    do Importar.data(db,cajeros,"cajero",@null)

    do PrintLog("\n")
    do PrintLog("====Importar agentes: "+str(@count(agentes))+" ====")
    do Importar.data(db,agentes,"agente",@null)

    do PrintLog("\n")
    do PrintLog("====Importar marcas: "+str(@count(marcas))+" ====")
    do Importar.data(db,marcas,"marca",@null)

    do PrintLog("\n")
    do PrintLog("====Importar departamentos: "+str(@count(departamentos))+" ====")
    do Importar.data(db,departamentos,"departamento",@null)

    do PrintLog("\n")
    do PrintLog("====Importar repartidores: "+str(@count(repartidores))+" ====")
    do Importar.data(db,repartidores,"repartidor",@null)

    do PrintLog("\n")
    do PrintLog("====Importar almacenes: "+str(@count(almacenes))+" ====")
    do Importar.data(db,almacenes,"almacen",@null)

    do PrintLog("\n")
    do PrintLog("====Importar configuración de impuestos: "+str(@count(cfgimpuestos))+" ====")
    point @function_validate to ValidateCfgImpueto
    do Importar.data(db,cfgimpuestos,"cfgimpuesto",@function_validate)

    do PrintLog("\n")
    do PrintLog("====Importar tipos de clientes: "+str(@count(tipoclientes))+" ====")
    do Importar.data(db,tipoclientes,"tipocliente",@null)

    do PrintLog("\n")
    do PrintLog("====Importar clientes: "+str(@count(clientes))+" ====")
    point @function_validate to ValidateCliente
    do Importar.data(db,clientes,"cliente",@function_validate)

    do PrintLog("\n")
    do PrintLog("====Importar centro de consumos: "+str(@count(cconsumos))+" ====")
    point @function_validate to ValidateCConsumo
    do Importar.data(db,cconsumos,"cconsumo",@function_validate)

    do PrintLog("\n")
    do PrintLog("====Importar centro de producción: "+str(@count(cproduccion))+" ====")
    point @function_validate to ValidateCProduccion
    do Importar.data(db,cproduccion,"cproduccion",@function_validate)

    do PrintLog("\n")
    do PrintLog("====Importar cajas: "+str(@count(cajas))+" ====")
    do Importar.data(db,cajas,"caja",@null)

    // //importar linea, pide una clase
    do PrintLog("\n")
    do PrintLog("====Importar línea: "+str(@count(lineas))+" ====")
    do Importar.data(db,lineas,"linea",@null)


    module "Importar productos, servicios,recetas"
    {
        if @hide_productos
        {
            do dbr.execute(db,"update producto set sys_info='v12import';",@null)
        }
        // //importar producto
        do PrintLog("\n")
        do PrintLog("====Importar productos: "+str(@count(productos))+" ====")
        do Importar.producto(db,productos)
        
        do PrintLog("\n")
        do PrintLog("====Importar productos de ensambles o recetas constantes: "+str(@count(productos_elementos))+" ====")
        do Importar.producto(db,productos_elementos)

        do PrintLog("\n")
        do PrintLog("====Importar productos de ensambles y remplazos: "+str(@count(productos_remplazos))+" ====")
        do Importar.producto(db,productos_remplazos)

        //liberar productos
        if @hide_productos
        {
            do dbr.execute(db,"update producto set visible=0 where sys_info='v12import';",@null)
            // do dbr.execute(db,"update producto set sys_info=null where sys_info='v12import' ",@null)
        }
        
    }
    
    // //importar precio de venta
    do PrintLog("\n")
    do PrintLog("====Importar precio de venta por cliente: "+str(@count(precios_x_cliente))+" ====")
    point @function_validate to ValidatePrecioVenta
    do Importar.data(db,precios_x_cliente,"precioventa",@function_validate)

    do PrintLog("\n")
    do PrintLog("====Importar ensambles o recetas constantes: "+str(@count(ensambles))+" ====")
    point @function_validate to ValidateEnsamble
    do Importar.data(db,ensambles,"iensamble",@function_validate)

    do PrintLog("\n")
    do PrintLog("====Importar grupos de productos: "+str(@count(grupoproductos))+" ====")
    point @function_validate to ValidateGrupoProducto
    do Importar.data(db,grupoproductos,"grupoproductos",@function_validate)

    do PrintLog("\n")
    do PrintLog("====Importar recetas variables: "+str(@count(variables))+" ====")
    point @function_validate to ValidateVariables
    do Importar.data(db,variables,"ivariable",@function_validate)

    do PrintLog("\n")
    do PrintLog("====Importar productos - centro de produción : "+str(@count(cproducionproductos))+" ====")
    point @function_validate to ValidateCprodProducto
    do Importar.data(db,cproducionproductos,"cproduccion_producto_",@function_validate)

    do PrintLog("\n")
    do PrintLog("***** ===== Proceso terminado correctamente ===== *****")

    do @context.end()
    //control de exception general
    exception
    {
        do PrintLog("Error: "+last_error())
        if isset("db")
        {
            //si la bd esta abierta, realizar los siguiente.
            if dbr.is_open(db)
            {
                //si la bd esta en transacción, deshacer todo
                if  dbr.in_transaction(db){do dbr.rollback(db)}
                //cerrar base de datos
                do dbr.close(db)
            }
        }
    }

    do SaveLog(@PathLog)
}