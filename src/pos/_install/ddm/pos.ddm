#include "ddm.dkh"
model "erp.pos"
{
    #include "induxsoft.abstracts.ddm"

    entity "divisa" : "TableModel" {}
    entity "cdocumentos" : "EnumModel" {}
    entity "categoria" : "TableModel"{}
    //procesador de cards
    entity "pos_present_card_processor"
    {
        @"id" string(32) key unique required
        @"title" string(50) required
        @"driver" string(150) required
    }
    entity "pos_present_card_caller":"TableModel"
    {
        @"id" string(32) unique required
        @"key1" string(150) //"Id de terminal"
        @"key2" string(150) //"Campo previsto pero no usado por globalpay"
	    @"key3" string(150) //"Campo previsto pero no usado por globalpay"
    }
    //#region Domicilio
    entity "pais" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"codigotel" string(5)
        @"nombre" string(100) unique required
    }
    entity "edoprov" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"nombre" string(50) required
        @"ipais" int ref:"pais" ["sys_pk"] required
    }
    entity "ciudad" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"codigotel" string(5)
        @"nombre" string(100) required
        @"estado" int ref:"edoprov" ["sys_pk"] required
    }
    entity "domicilio" : "TableModel"
    {
        @"codpos" string(10)
        @"colonia" string(150)
        @"direccion" string(1024)
        @"notas" string(150)
        @"telefonos" string(150)
        @"iciudad" int ref:"ciudad" ["sys_pk"]
        @"numint" string(1024)
        @"numext" string(1024)
    }
    //#endregion

    entity "almacen" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(10) unique required
        @"descripcion" string(50) unique required
        @"email" string(50)
        @"fax" string(150)
        @"telefonos" string(150)
        @"website" string(150)
        @"domicilio1" ref:"domicilio"
        @"uf_movremoto" bool
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_formaproduccion" int
    }

    entity "cconsumo" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique required
        @"notas" string(2048)
        @"precio" int
        @"ialmacen" ref:"almacen"
        @"porcentaje_esperado" decimal(19,8)
        @"uf_domiciliocfd" int
        @"uf_expedicioncxc" int
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_grupoprod" int
    }

    entity "caja" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique
        @"notas" string(2048)
        @"centroconsumo" ref:"cconsumo" required
        @"uf_limefectivo" decimal(18,8)
        @"uf_lime_vntadic" int
        @"uf_lime_aviso" decimal(18,8)
        @"uf_lime_alerta" string(500)
        @"uf_lime_pkprimerventa" int
        @"uf_corte_req" bool
        @"uf_horacorte1" time
        @"uf_horacorte2" time
        @"uf_horacorte3" time
        @"uf_horacorte4" time
        @"uf_horacorte5" time
        @"uf_cortereq_vntadic" int
        @"uf_lim_vntliber" int
        @"ubicacion" ref:"ubicacion"
        @"pcardcaller" string ref:"pos_present_card_caller" ["id"]
    }
    entity "ubicacion" : "TableModel"
    {
        @"codigo" string(10) unique required
        @"descripcion" string(50) required
    }

    entity "agente" : "TableModel"
    {
        @"codigo" string(50) unique required
        @"codnomina" string(50) unique
        @"nombre" string(50) unique required
        @"domicilio1" ref:"domicilio"
        @"ubicacion" ref:"ubicacion"
        @"pcardcaller" string ref:"pos_present_card_caller" ["id"]
        @"caja" ref:"caja"
        @"caja2" ref:"caja"
    }
    entity "cajero" : "TableModel"
    {
        @"codigo" string(10) unique required
        @"codnomina" string(50) unique
        @"contrasena" string(32) required
        @"email" string(50)
        @"nombre" string(50) unique required
        @"notas" string(2048)
        @"telefono" string(25)
        @"domicilio1" ref:"domicilio"
        @"uf_sys_baja" bool
        @"ubicacion" ref:"ubicacion"
        @"agente" ref:"agente"
    }

    entity "tarjetacredito" : "TableModel"
    {
        @"codigo" string(25) unique required
        @"descripcion" string(50) unique required
        @"uf_porcomision" decimal(18,8) 
    }
    
    entity "pos_datapack" : "TableModel"
    {
        //sys_timestamp es la fecha y hora de la última vez que se envió para procesarse
        @"id" string(32) unique required // Es el identificador del paquete definido por la sucursal (R5)
        @"location_id" string(43) required //Es el identificador de la ubicación (sucursal) que remite el paquete
        @"processed" bool 		// Es true en ambas cuando ha sido correctamente procesado
        @"error" memo			// Mensaje del último error
        @"las_error" datetime	// Fecha y hora en que ocurrió el último error
        @"sended" bool 			// Es true en la base de datos local (satélite)
    }

    /* uod.dtarjeta */
    entity "dtarjeta" : "TableModel"
    {
        @"autorizacion" string(50)
        @"cvv" string(10)
        @"domicilio" string(1024)
        @"importe" decimal(18,8)
        @"nombre" string(50)
        @"numero" string(32)
        @"tipocambio" decimal(18,8)
        @"idivisa" int ref:"divisa" ["sys_pk"] required
        @"retiro" int ref:"movcaja" ["sys_pk"]
        @"tipo" int ref:"tarjetacredito" ["sys_pk"] required
        @"fk_movcaja_detalletarjetas" int ref:"movcaja" ["sys_pk"] required
        @"uf_porcomision" decimal(18,8)
    }
    /* uod.corte */
    entity "corte" : "TableModel"
    {
        @"cerrado" bool
        @"fapertura" date required
        @"fcierre" date
        @"hapertura" datetime required
        @"hcierre" datetime
        @"icaja" int ref:"caja" ["sys_pk"] required
        @"icajero" int ref:"cajero" ["sys_pk"]
    }
    /* uod.movcaja */
    entity "movcaja" : "TableModel"
    {
        @"auditado" bool
        @"cheques" decimal(18,8)
        @"contabilizado" bool
        @"depositos" decimal(18,8)
        @"documento" int ref:"cdocumentos" ["id"] required
        @"efectivo" decimal(18,8)
        @"fecha" date required
        @"hora" datetime required
        @"notas" string(255)
        @"partida" string(32)
        @"poliza" string(32)
        @"referencia" string(50) required
        @"tarjetas" decimal(18,8)
        @"tipocambio" decimal(18,8)
        @"vales" decimal(18,8)
        @"icategoria" int ref:"categoria" ["sys_pk"] required
        @"icorte" int ref:"corte" ["sys_pk"] required
        @"idivisa" int ref:"divisa" ["sys_pk"] required

        index "idx_movcaja" unique
        {
            field "cheques"
            field "efectivo"
            field "fecha"
            field "notas"
            field "referencia"
            field "tarjetas"
            field "vales"
        }
    }
    /* uod.ddepositos */
    entity "ddepositos" : "TableModel"
    {
        @"banco" string(50) required
        @"fecha" date required
        @"importe" decimal(18,8)
        @"referencia" string(50)
        @"tipocambio" decimal(18,8)
        @"idivisa" int ref:"divisa" ["sys_pk"] required
        @"retiro" int ref:"movcaja" ["sys_pk"]
        @"fk_movcaja_detalledepositos" int ref:"movcaja" ["sys_pk"] required
    }
    /* uod.dcheques */
    entity "dcheques" : "TableModel"
    {
        @"banco" string(50) required
        @"beneficiario" string(50) required
        @"emisor" string(50) required
        @"importe" decimal(18,8)
        @"notas" string(50)
        @"numero" string(5) required
        @"tipocambio" decimal(18,8)
        @"idivisa" int ref:"divisa" ["sys_pk"] required
        @"retiro" int ref:"movcaja" ["sys_pk"]
        @"fk_movcaja_detallecheques" int ref:"movcaja" ["sys_pk"] required
    }
     /* uod.dvales */
    entity "dvales" : "TableModel"
    {
        @"fecha" date
        @"importe" decimal(18,8)
        @"notas" string(50)
        @"referencia" string(50) required
        @"tipocambio" decimal(18,8)
        @"idivisa" int ref:"divisa" ["sys_pk"] required
        @"retiro" int ref:"movcaja" ["sys_pk"]
        @"fk_movcaja_detallevales" int ref:"movcaja" ["sys_pk"] required
    }
}