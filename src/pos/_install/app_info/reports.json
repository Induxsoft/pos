                "title":"Consulta de movimiento de caja por caja y cajero",
                "qry":"select IFNULL(f.folio,m.sys_pk)as folio,date_format(m.fecha,'%Y-%m-%d')fecha,date_format(m.hora,'%r')hora,m.referencia,c.descripcion as categoria,d.const as documento,m.efectivo,m.cheques,m.tarjetas,m.vales,m.depositos,dv.descripcion,m.notas,ifnull(v.sys_pk,0) pk_venta from movcaja m inner join categoria c on m.icategoria=c.sys_pk inner join cdocumentos d on m.documento=d.id inner join divisa dv on m.idivisa=dv.sys_pk left JOIN venta v on m.sys_pk=v.imovcaja LEFT JOIN foliosdocumentos f on v.ifolio=f.sys_pk where if(IFNULL(@corte,'*')='*' or IFNULL(@corte,'')='',true,m.icorte=@corte) GROUP BY m.sys_pk order by m.sys_pk desc limit 250;",
                "properties":{"layout":"view"},
                "parameters":{"corte":{"default":"","id":"corte","name":"corte","caption":"Corte:","control":"InputKey","required":false,"readonly":false,"disabled":false,"wrp_attr":{"class":"col-lg-4"},"source":{"columns":"sys_pk,corte","ccaptions":"#,Corte","obj_data":[{"column":"sys_pk","caption":"#"},{"column":"corte","caption":"Corte"}],"type":"query","query":"Select co.sys_pk,concat(c.codigo,' ',c.descripcion,' ',cj.codigo,' ',cj.nombre,' ', co.fapertura,' ', time(co.hapertura), ' ', if(ifnull(co.cerrado,0)=0,'Abierto','Cerrado') ) corte from corte co inner join caja c on co.icaja=c.sys_pk inner join cajero cj on co.icajero=cj.sys_pk where if(@key is null,c.codigo like concat('%',@search,'%') or c.descripcion like concat('%',@search,'%'), co.sys_pk=@key) order by co.sys_pk desc;","keyfield":"sys_pk","showfield":"corte","searchfield":"sys_pk"}}},
