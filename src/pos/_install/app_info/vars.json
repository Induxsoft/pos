                "vartype": "string",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"query",
                        "query":"select c.codigo,concat(c.codigo,' - ',c.descripcion)descripcion from categoria c where ifnull(c.sys_deleted,0)=0",
