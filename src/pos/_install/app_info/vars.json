[
    {
        "id": "general",
        "caption": "@General",
        "help": "Configuraciones comunes a todos los paquetes"
    },
    {
        "id": "autocode",
        "caption": "Autocódigo",
        "help": "Formatos de autocódigos",
        "parent":"general"
    },
    {
        "id": "autocode.pos",
        "caption": "Punto de Venta",
        "help": "Formatos de autocódigos",
        "parent":"autocode",
        "vars": 
        [
            {
                "varname": "FXCA049",
                "vardefault": "|0000",
                "varvalue": "|0000",
                "varcaption": "Formato de código para cajas",
                "vartype": "string",
                "varinput": { "control": "text" }
            },
            {
                "varname": "FXCA050",
                "vardefault": "|0000",
                "varvalue": "|0000",
                "varcaption": "Formato de código para cajeros",
                "vartype": "string",
                "varinput": { "control": "text" }
            },
            {
                "varname": "FXCA064",
                "vardefault": "|0000",
                "varvalue": "|0000",
                "varcaption": "Formato de código para tarjetas",
                "vartype": "string",
                "varinput": { "control": "text" }
            }
        ]
    },
    {
        "id": "pos",
        "caption": "Punto de Venta",
        "help": "Variable globales: POS",
        "vars": 
        [
            {
                "varname": "pos_corte_ciego",
                "vardefault": "Sí",
                "varvalue": "Sí",
                "varcaption": "Cierre de caja con corte ciego",
                "varhelp": "Cierre de caja con corte ciego",
                "vartype": "bool",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"list",
                        "values":
                        [
                            {"val":"false", "text":"No"},
                            {"val":"true", "text":"Sí"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "pos_cat_egreso_x_corte",
                "vardefault": "",
                "varvalue": "",
                "varcaption": "Categoría para egresos por corte.",
                "varhelp": "Categoría predeterminada de egresos por corte de caja automático.",
                "vartype": "int",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"query",
                        "query":"select c.sys_pk,concat(c.codigo,' - ',c.descripcion)descripcion from categoria c where ifnull(c.sys_deleted,0)=0",
                        "keyfield":"sys_pk",
                        "showfield":"descripcion"
                    }
                }
            },
            {
                "varname": "pos_cat_ingreso_x_sobrante",
                "vardefault": "",
                "varvalue": "",
                "varcaption": "Categoría para ingreso por sobrante.",
                "varhelp": "Categoría predeterminada de ingreso por sobrante.",
                "vartype": "int",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"query",
                        "query":"select c.sys_pk,concat(c.codigo,' - ',c.descripcion)descripcion from categoria c where ifnull(c.sys_deleted,0)=0",
                        "keyfield":"sys_pk",
                        "showfield":"descripcion"
                    }
                }
            },
            {
                "varname": "pos_cat_ingreso_x_faltante",
                "vardefault": "",
                "varvalue": "",
                "varcaption": "Categoría para egreso por faltante.",
                "varhelp": "Categoría predeterminada de egreso por faltante.",
                "vartype": "int",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"query",
                        "query":"select c.sys_pk,concat(c.codigo,' - ',c.descripcion)descripcion from categoria c where ifnull(c.sys_deleted,0)=0",
                        "keyfield":"sys_pk",
                        "showfield":"descripcion"
                    }
                }
            },
            {
                "varname": "pos_url_root_img_foot_line",
                "vardefault": "",
                "varvalue": "",
                "varcaption": "Url raíz para las imagenes",
                "varhelp": "Se usa al hacer una comanda, Ejemplo: https://demo.localhost/",
                "vartype": "string",
                "varinput": 
                {
                    "control": "string"
                }
            },
            {
                "varname": "pos_porcentaje_propina",
                "vardefault": "5",
                "varvalue": "5",
                "varcaption": "Porcentaje de propina",
                "varhelp": "",
                "vartype": "number",
                "varinput": 
                {
                    "control": "number"
                }
            },
            {
                "varname": "pos_type_card",
                "vardefault": "001",
                "varvalue": "001",
                "varcaption": "Tipo de tarjeta",
                "varhelp": "Tipo de tarjeta, se usará si no se encuentra un tipo de tarjeta en relación a los datos de la transacción",
                "vartype": "string",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"query",
                        "query":"SELECt codigo,CONCAT(codigo,' - ',descripcion)descripcion FROM tarjetacredito WHERE IFNULL(sys_deleted,0)=0",
                        "keyfield":"codigo",
                        "showfield":"descripcion"
                    }
                }
            },
            {
                "varname": "pos_card_procesor",
                "vardefault": "globalpay",
                "varvalue": "globalpay",
                "varcaption": "Procesador de tarjetas",
                "varhelp": "Procesador de tarjetas al cobrar una comanda",
                "vartype": "string",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"query",
                        "query":"select id, concat(title,' - [',driver,']')title from pos_present_card_processor",
                        "keyfield":"id",
                        "showfield":"title"
                    }
                }
            },
            {
                "varname": "pos_afectar_existencias",
                "vardefault": "false",
                "varvalue": "false",
                "varcaption": "Afectar existencias al importar ventas.",
                "varhelp": "Si es true la terminar de importar ventas por la herramienta del kit de emergencia, este se hará las salidas de existencias.",
                "vartype": "bool",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"list",
                        "values":
                        [
                            {"val":"false", "text":"No"},
                            {"val":"true", "text":"Sí"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            },
            {
                "varname": "pos_detener_primer_error",
                "vardefault": "true",
                "varvalue": "true",
                "varcaption": "Detener al primer error de salida de existencia.",
                "varhelp": "Si es false, se omiten los errores y trata de procesar las ventas pendientes.",
                "vartype": "bool",
                "varinput": 
                {
                    "control": "select",
                    "source":
                    {
                        "type":"list",
                        "values":
                        [
                            {"val":"false", "text":"No"},
                            {"val":"true", "text":"Sí"}
                        ],
                        "showfield":"text",
                        "keyfield":"val"
                    }
                }
            }
        ]
    }
]