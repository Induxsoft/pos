#include "dkli.dkh"
#!
module ""
{
    new @config_import
    {     
        member @"corte"
        {
            
            @"target":"corte"
            @"identity":"sys_guid=@sys_guid;"
            @"insert":"*"
            member @"queryfields"
            {
                @"icaja":"select sys_pk from caja where codigo=@icaja"
                @"icajero":"select sys_pk from cajero where codigo=@icajero"
            }
        } //corte  
        member @"foliosdocumentos"
        {
            @"target":"foliosdocumentos"
            @"identity":"sys_guid=@sys_guid or (folio=@folio and block=@block);"
            @"insert":"*"
            @"after":"update blockdocumentos set fultimo=(SELECT ifnull(MAX(f.folio),0) FROM foliosdocumentos f WHERE f.`Block`=@block) where sys_pk=@block"
            member @"queryfields" 
            {
                @"Block":"select sys_pk from blockdocumentos where concat(documento,'-',serie)=@Block;" 
            }
            member @"childs"  //Especifica las subconsultas de origen para las transacciones incluidas por cada fila de 'source'
            {
                member "Venta"
                {
                    @"target":"Venta"
                    @"identity":"sys_guid=@sys_guid;"
                    @"insert":"*"
                    @"row_in_transaction":@true // solo puede ver una transaccion, como ya hay una en venta no puede ver otra en foliosdocumentos, ni en dventa
                                                // si hubiera una transaccion en  foliosdocumentos, no podria ver otra en venta ni dventa
                                                //motivo, podria ocacionar un bucles de transaccion o hacer el commit en momento donde no se debe
                                                //igual sucederia con los otros elementos
                    member @"queryfields" 
                    {
                        @"ICliente":"select sys_pk from cliente where codigo=@icliente;" 
                        @"IFolio":"select sys_pk from foliosdocumentos where sys_guid=@Ifolio;"
                        @"ICConsumo":"select sys_pk from cconsumo where codigo=@ICConsumo;"
                        @"IAgente":"select sys_pk from agente where codigo=@IAgente;"
                        @"ICaja":"select sys_pk from caja where codigo=@ICaja;"
                        @"IDivisa":"select sys_pk from Divisa where codigo=@IDivisa;"
                        @"IMovcaja":"select sys_pk from movcaja where sys_guid=@IMovcaja;"
                        @"IPorteador":"select sys_pk from porteador where codigo=@IPorteador;"
                        @"IRepartidor":"select sys_pk from repartidor where codigo=@IRepartidor;"
                        @"ICorte":"select sys_pk from corte where Sys_guid=@ICorte;"
                        @"AplicadoA":"select sys_pk from venta where Sys_guid=@AplicadoA;"
                    } 
                    member @"childs"
                    {
                        member "DVenta"
                        {
                            @"identity":"sys_guid=@sys_guid;"
                            @"target":"DVenta"
                            @"insert":"*"
                            @"after":"update dventa set xsalir=0 where sys_guid=@sys_guid and sys_lastuser='dprod'"
                            member @"queryfields" 
                            {
                                @"FK_Venta_Detalle":"select sys_pk from venta where sys_guid=@FK_Venta_Detalle;" 
                                @"IProducto":"select sys_pk from producto where codigo=@IProducto;"
                                @"IAlmacen":"select sys_pk from almacen where codigo=@IAlmacen;"
                                @"Documento":"select sys_pk from venta where Sys_guid=@Documento;"
                                // @"XSalir":"select ifnull(@Cantidad,0)" 
                                @"XSalir":"SELECT 
                                        if(
                                            IFNULL((SELECT p.itipo=2 FROM producto p WHERE p.sys_pk=@IProducto OR p.codigo=@IProducto),false)
                                            ,
                                            IFNULL(@Cantidad,0)
                                            ,0);"
                                @"sys_lastuser":"select sys_lastuser from dventa where sys_guid=@sys_guid"
                            } // queryfields
                        } // DVenta
                        member "movcaja"
                        {
                            @"identity":"sys_guid=@sys_guid;"
                            @"target":"movcaja"
                            @"insert":"*"  
                            member @"queryfields" 
                            {
                                @"ICategoria":"select sys_pk from categoria where codigo=@ICategoria;" 
                                @"ICorte":"select sys_pk from corte where sys_guid=@ICorte;"
                                @"IDivisa":"select sys_pk from divisa where codigo=@IDivisa;"
                            } // queryfields    
                        } // movcaja
                    }   //También podría tener sus propias sub-consultas           
                } // Venta
            } //member   
        } //FoliosDocumentos    
        member @"orden"
        {
            @"target":"orden"
            @"identity":"sys_guid=@sys_guid;"
            @"insert":"*"
            @"row_in_transaction":@true 
            member @"queryfields" 
            {
                @"iagente":"select sys_pk from agente where codigo=@iagente"
                @"status":"select id from cstatusordenproduccion where const=@status"
                @"icconsumo":"select sys_pk from cconsumo where codigo=@icconsumo"
                @"icproduccion":"select sys_pk from cproduccion where codigo=@icproduccion"
                @"idivisa":"select sys_pk from divisa where codigo=@idivisa"
                @"iventa":"select sys_pk from venta where referencia=@iventa"
                @"status":"SELECT if(v.StatusAdministrativo=3,3,@status) FROM venta v WHERE (v.sys_pk=@iventa or v.referencia=@iventa)"
            }
            member @"childs"
            {
                member "dorden"
                {
                    @"target":"dorden"
                    @"identity":"sys_guid=@sys_guid;"
                    @"insert":"*"
                    member @"queryfields" 
                    {
                        @"idivisa":"select sys_pk from divisa where codigo=@idivisa"
                        @"iproducto":"select sys_pk from producto where codigo=@iproducto;"
                        @"fk_orden_detalle":"select sys_pk from orden where referencia=@fk_orden_detalle"
                    }
                    member "childs"
                    {
                        member @"dadicionales"
                        {
                            @"target":"dadicionales"
                            @"identity":"sys_guid=@sys_guid;"
                            @"insert":"*"
                            member @"queryfields" 
                            {
                                @"iproducto":"select sys_pk from producto where codigo=@iproducto;"
                                @"fk_dorden_adicionales":"select sys_pk from dorden where sys_guid=@fk_dorden_adicionales"
                            }
                        }
                        member @"dcantidades"
                        {
                            @"target":"dcantidades"
                            @"identity":"sys_guid=@sys_guid;"
                            @"insert":"*"
                            member @"queryfields" 
                            {
                                @"cantidad":"select id from ccantidades where const=@cantidad"
                                @"iproducto":"select sys_pk from producto where codigo=@iproducto;"
                                @"fk_dorden_cantidadesvariadas":"select sys_pk from dorden where sys_guid=@fk_dorden_cantidadesvariadas"
                            }
                        }
                    }
                }
            }
        }      
    }
}