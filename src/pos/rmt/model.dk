#include "dkli.dkh"
#!
module ""
{
    #include "querys.dkl"
    #include "lib.dk"
    #include "dbr.ftt.dkl"
    #include "config.import.dkl"

    TableExist::&db,table
    {
        table >> p
        name_table=dbr.str(db,"SHOW TABLES LIKE '"+table+"';",p)
        return trim(name_table)!=""
    }
    
    Exportar::&db,&params
    {
        do dbr.apps.action.grant("VP50")
        if trim(@@(params,"$ub"))!=""{params<"_entiy_id">:trim(@@(params,"$ub"))}
        
        ref entity= dbr.rec(db,ftext(@list_ubicaciones),params)
        
        ref cconsumos=dbr.list(db,ftext(@list_cconsumo),entity)
        ref cproducciones=dbr.list(db,ftext(@list_cproducion),entity)
        ref lineas=dbr.list(db,ftext(@list_lineas_rel),entity)
        ref productos=dbr.list(db,ftext(@list_productos_rel),entity)
        if @count(lineas)<1{ref lineas=dbr.list(db,ftext(@list_lineas),params)}

        get_prod_elements=@true
        if @count(productos) < 1
        {
            @__inner_join_prod=""
            @__conditional_prod="true"
            ref productos=dbr.list(db,ftext(@list_productos_rel),params)
            get_prod_elements=@false
        }


        new data_export
        {
            @"ubicacion*":entity
            @"divisas*":dbr.list(db,ftext(@list_divisas),params)
            @"cconsumo*":cconsumos
            @"cproduccion*":cproducciones
            @"cajas*":dbr.list(db,ftext(@list_cajas),entity)
            @"cajeros*":dbr.list(db,ftext(@list_cajeros),entity)
            @"agentes*":dbr.list(db,ftext(@list_agentes),entity)
            @"repartidores*":dbr.list(db,ftext(@list_repartidores),entity)
            @"almacenes*":dbr.list(db,ftext(@list_almacenes),entity)
            @"lineas*":lineas
            @"productos*":productos
            @"marcas*":dbr.list(db,ftext(@list_marcas),params)
            @"departamentos*":dbr.list(db,ftext(@list_departamentos),params)
            @"cfgimpuestos*":dbr.list(db,ftext(@list_impuestos),params)
            @"tipoclientes*":dbr.list(db,ftext(@list_tipoclientes),params)
            @"clientes*":dbr.list(db,ftext(@list_clientes),params)
            @"precios_x_cliente*":dbr.list(db,ftext(@list_precios_clientes),params)
            @"ensambles*":dbr.list(db,ftext(@list_ensamble),entity)
            @"grupoproductos*":list.create()
            @"variables*":list.create()
            @"productos_elementos*":list.create()
            @"productos_remplazos*":list.create()
            @"cproducionproductos*":list.create()
        }
        if TableExist(db,"cproduccion_producto_")
        {
            data_export<"cproducionproductos*">:dbr.list(db,ftext(@list_cproducion_productos),entity)
        }
        if TableExist(db,"ivariable")
        {
            using data_export
            {
                @"grupoproductos*":dbr.list(db,ftext(@list_gruposproductos),entity)
                @"variables*":dbr.list(db,ftext(@list_variables),entity)
            }
        }

        if get_prod_elements
        {
            if TableExist(db,"iensamble")
            {
                @__inner_join_prod="INNER JOIN iensamble ie ON ie.elemento=p.sys_pk
                LEFT JOIN ut_cc_linea ccl ON l.sys_pk=ccl.uf_ilinea
                LEFT JOIN cconsumo cc ON ccl.uf_icc=cc.sys_pk"

                @__conditional_prod="if(IFNULL(@ubicacion,0)=0,TRUE,cc.ubicacion=@ubicacion)"

                data_export<"productos_elementos*">:dbr.list(db,ftext(@list_productos_rel),entity)
                
                @__inner_join_prod="INNER JOIN iensamble ie ON ie.reemplazo=p.sys_pk
                LEFT JOIN ut_cc_linea ccl ON l.sys_pk=ccl.uf_ilinea
                LEFT JOIN cconsumo cc ON ccl.uf_icc=cc.sys_pk"

                data_export<"productos_remplazos*">:dbr.list(db,ftext(@list_productos_rel),entity)
            }
        }
        return data_export
    }
    
    Importar::&db,&params
    {
        do dbr.apps.action.grant("VP50")
        id=trim(@@(params,"$id"))
        new pos_datapack
        {
            @"id":id
            @"ubicacion":trim(@@(params,"$location_id"))
        }
        do CreatePosData(db,pos_datapack)

        ref data=@@(params,"&data")
        // do file.wtext("C:/Users/Dev/Documents/devkrons/devkronNet/pos/rmt/"+id+".json",to.json(data))
        do dbr.ftt.import(db,data,@config_import)

        new pos_datapack
        {
            @"processed":@true
        }
        do UpdateTrasaction(db,pos_datapack,id)

        return record.create()

        exception
        {
            error=last_error()
            if isset("id")
            {
                new pos_datapack
                {
                    @"error":error
                    @"las_error*":dbr.sql("now()")
                }
                do UpdateTrasaction(db,pos_datapack,id)
            }
            do rise_error(500,error)
        }
    }
    point @read to Exportar
    point @create to Exportar
    point @update to Exportar
    point @list to Exportar
}