#include "dkli.dkh"
#!
module ""
{
    #include "querys.dkl"
    #include "lib.dk"
    #include "dbr.ftt.dkl"
    #include "config.import.dkl"
    #include "inventario/movimientos.dkh"
    #include "dprod/dprod.dk"

    TableExist::&db,table
    {
        table >> p
        name_table=dbr.str(db,"SHOW TABLES LIKE '"+table+"';",p)
        return trim(name_table)!=""
    }
    
    Exportar::&db,&params
    {
        do dbr.apps.action.grant("VP50")
        if trim(@@(params,"$ub"))!=""{params<"_entiy_id">:trim(@@(params,"$ub"))}
        
        ref entity= dbr.rec(db,ftext(@list_ubicaciones),params)
        
        ref cconsumos=dbr.list(db,ftext(@list_cconsumo),entity)
        
        ref lineas=dbr.list(db,ftext(@list_lineas_rel),entity)
        ref productos=dbr.list(db,ftext(@list_productos_rel),entity)
        if @count(lineas)<1{ref lineas=dbr.list(db,ftext(@list_lineas),params)}

        get_prod_elements=@true
        if @count(productos) < 1
        {
            @__inner_join_prod=""
            @__conditional_prod="true"
            ref productos=dbr.list(db,ftext(@list_productos_rel),params)
            get_prod_elements=@false
        }


        new data_export
        {
            @"ubicacion*":entity
            @"divisas*":dbr.list(db,ftext(@list_divisas),params)
            @"cconsumo*":cconsumos
            @"cproduccion*":list.create()
            @"cajas*":dbr.list(db,ftext(@list_cajas),entity)
            @"cajeros*":dbr.list(db,ftext(@list_cajeros),entity)
            @"agentes*":dbr.list(db,ftext(@list_agentes),entity)
            @"repartidores*":dbr.list(db,ftext(@list_repartidores),entity)
            @"almacenes*":dbr.list(db,ftext(@list_almacenes),entity)
            @"lineas*":lineas
            @"productos*":productos
            @"marcas*":dbr.list(db,ftext(@list_marcas),params)
            @"departamentos*":dbr.list(db,ftext(@list_departamentos),params)
            @"cfgimpuestos*":dbr.list(db,ftext(@list_impuestos),params)
            @"tipoclientes*":dbr.list(db,ftext(@list_tipoclientes),params)
            @"clientes*":dbr.list(db,ftext(@list_clientes),params)
            @"precios_x_cliente*":dbr.list(db,ftext(@list_precios_clientes),params)
            @"ensambles*":dbr.list(db,ftext(@list_ensamble),entity)
            @"grupoproductos*":list.create()
            @"variables*":list.create()
            @"productos_elementos*":list.create()
            @"productos_remplazos*":list.create()
            @"cproducionproductos*":list.create()
            @"cconsumo_cproduccion*":list.create()
            @"foliosdocumentos*":list.create()//dbr.list(db,ftext(@list_folios_documentos),entity)
            @"block_documentos*":dbr.list(db,ftext(@list_block_documentos),entity)
        }
        if TableExist(db,"cproduccion")
        {
            using data_export
            {
                @"cproduccion*":dbr.list(db,ftext(@list_cproducion),entity)
            }
        }
        if TableExist(db,"cconsumo_cproduccion_")
        {
            data_export<"cconsumo_cproduccion*">:dbr.list(db,ftext(@list_cconsumo_cproduccion),entity)
        }
        if TableExist(db,"cproduccion_producto_")
        {
            data_export<"cproducionproductos*">:dbr.list(db,ftext(@list_cproducion_productos),entity)
        }
        if TableExist(db,"ivariable") 
        {
            using data_export
            {
                @"grupoproductos*":dbr.list(db,ftext(@list_gruposproductos),entity)
                @"grupoproductos_producto*":dbr.list(db,ftext(@list_join_grupos_productos),entity)
            }

            if TableExist(db,"cimpadicionales")
            {
                data_export<"variables*">:dbr.list(db,ftext(@list_variables),entity)
            }
        }

        if get_prod_elements
        {
            if TableExist(db,"iensamble")
            {
                @__inner_join_prod="INNER JOIN iensamble ie ON ie.elemento=p.sys_pk
                LEFT JOIN ut_cc_linea ccl ON l.sys_pk=ccl.uf_ilinea
                LEFT JOIN cconsumo cc ON ccl.uf_icc=cc.sys_pk"

                @__conditional_prod="if(IFNULL(@ubicacion,0)=0,TRUE,cc.ubicacion=@ubicacion)"

                data_export<"productos_elementos*">:dbr.list(db,ftext(@list_productos_rel),entity)
                
                @__inner_join_prod="INNER JOIN iensamble ie ON ie.reemplazo=p.sys_pk
                LEFT JOIN ut_cc_linea ccl ON l.sys_pk=ccl.uf_ilinea
                LEFT JOIN cconsumo cc ON ccl.uf_icc=cc.sys_pk"

                data_export<"productos_remplazos*">:dbr.list(db,ftext(@list_productos_rel),entity)
            }
        }
        return data_export
    }
    
    PrepareGlobalVars::&db
    {
        cat=dbr.vars.get(db,"v12.ventas.salida")
        cat >> p
        cventa=dbr.num(db,"select sys_pk from categoria where codigo=@cat",p)
        if parse.num(cventa)<1{do rise_error(500,"No ha configurado una categoria Salidas por ventas `v12.ventas.salida` ")}

        new args
        {
            @"c-venta":cventa
        }
        @erp.dprod.CLASES="2,4,5,6" 
        @erp.dprod.TIPOS_PRODUCTOS_SALIDA_VENTAS="2"
        @dias_ventas=field.dnum(args,"dias-ventas",7) //dias-ventas=n. Cantidad de días atrás (n) a tomar en cuenta como máximo de la lista de ventas pendientes.
        @limit_ventas=field.dnum(args,"limit-ventas",100)//limit-ventas=l. Cantidad de filas (l) a tomar en cuenta como máximo de la lista de ventas pendientes.
        @cat_prod_ventas=field.dnum(args,"c-venta",8) //Clave primaria de la categoría para salida por ventas
        @pre_errors=@true //preservar-errores. Guarda los errores de producción o salida por ventas en la tabla 'dprod_log'.
        @f_inicio=@@(args,"$f_inicio")//f_inicio=f. Fecha de inicio del rango de fechas, en donde f es una expresada con el formato yyyy-mm-dd.
        @f_final=@@(args,"$f_final") //f_final=f. Fecha final del rango de fechas, en donde f es una expresada con el formato yyyy-mm-dd.
        @kventa=field.dnum(args,"k-venta",0)//k-venta=pk. La clave primaria (pk) de una venta en particular que será la única en ser procesada
        @rventa=field.dstr(args,"venta","")//venta=r. La referencia (r) de una venta en particular que será la única en ser procesada

        return args
    }
    Importar::&db,&params
    {
        ref @LAST_DCARDEX=@null
        do dbr.apps.action.grant("VP51")
        do errordet(@false)
        id=trim(@@(params,"$id"))   
        do PrepareGlobalVars(db)

        new pos_datapack
        {
            @"id":id
            @"ubicacion":trim(@@(params,"$location_id"))
        }
        do CreatePosData(db,pos_datapack)

        ref data=@@(params,"&data")
        if isnull(data){do rise_error(500,"El objeto `data` es nulo")}
        
        do dbr.ftt.import(db,data,@config_import)

        new pos_datapack
        {
            @"processed":@true
        }
        do UpdateTrasaction(db,pos_datapack,id)
        //sincronizar existencias
        
        new params_salidas
        {
            dias:=@dias_ventas
            limite:=@limit_ventas
            cat_venta:=@cat_prod_ventas
            preservar_log:=@pre_errors
            f_inicio:=@f_inicio
            f_final:=@f_final
            kventa:=@kventa
            rventa:=@rventa
            gen_error:=@true
        }
        
        if parse.bool(dbr.vars.get(db,"pos_afectar_existencias"))
        {
            do erp.dprod.salidasxventas(db,params_salidas)
        }

        return record.create()

        exception
        {
            error=last_error()
            if isset("id")
            {
                if not(isnull(@LAST_DCARDEX))
                {
                    error=error + "\r\nProducto: "+@@(@LAST_DCARDEX,"$cod_prod")+" - "+@@(@LAST_DCARDEX,"$desc_prod")
                }
                new pos_datapack
                {
                    @"error":error
                    @"las_error*":dbr.sql("now()")
                }
                do UpdateTrasaction(db,pos_datapack,id)
            }
            do rise_error(500,error)
        }
    }
    point @read to Exportar
    point @create to Exportar
    point @update to Exportar
    point @list to Exportar
}